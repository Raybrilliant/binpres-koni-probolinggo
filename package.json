    "elysia": "latest"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "bun": "^1.4.0",
    "bun-types": "latest",
    "drizzle-kit": "^1.0.0-rc.4"
  },
  "module": "src/index.js"
}
