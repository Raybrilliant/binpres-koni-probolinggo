# Wajib ganti di produksi (minimal 32 karakter acak)
JWT_SECRET=dev-secret-ganti-di-produksi-jangan-pakai-ini
PORT=3000
# Origin frontend yang boleh mengakses API (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:4321
# URL PostgreSQL (wajib)
DB_URL=postgresql://user:password@host:5432/nama_database
UPLOAD_DIR=uploads
# Rate limit permintaan per menit per IP
RATE_LIMIT=300
