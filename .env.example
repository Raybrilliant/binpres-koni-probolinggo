# URL publik situs (TANPA trailing slash) — dipakai untuk canonical,
# Open Graph, sitemap.xml, dan robots.txt. WAJIB diisi di produksi.
PUBLIC_SITE_URL=https://binpres.example.com

# URL backend yang dipakai BROWSER. Kosong = same-origin
# (dev: proxy Vite → :3000, produksi: reverse proxy).
PUBLIC_API_URL=

# URL backend yang dipakai SERVER saat SSR fetch (opsional).
# Bila backend se-VPS, biarkan kosong → fallback http://127.0.0.1:3000.
PRIVATE_API_URL=
