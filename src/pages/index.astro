---
import Landing from "../components/Landing.svelte";
import "../styles/global.css";

// foto statis lokal (unduhan Pexels) — isi identik di development & production
const heroImage = "/pexels/hero.jpg";
const photos = [1, 2, 3, 4, 5, 6].map((i) => `/pexels/pengurus-${i}.jpg`);
---

<html lang="id">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/png" href="/logo.png" />
        <title>BINPRES KONI Kota Probolinggo — Bina Prestasi</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
        <style is:global>
            @theme {
                --font-poppins: "Poppins", ui-sans-serif, system-ui, sans-serif;
            }
            body {
                font-family: "Poppins", ui-sans-serif, system-ui, sans-serif;
            }
            html {
                scroll-behavior: smooth;
            }
        </style>
    </head>
    <body class="bg-white antialiased">
        <Landing client:load {heroImage} {photos} />
    </body>
</html>
